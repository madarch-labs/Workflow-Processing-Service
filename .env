# Host ports for docker compose. On this machine 3000 and 5432 are already taken,
# so the UI and PostgreSQL are published on other ports.
WPS_UI_PORT=3080
WPS_PG_PORT=55432
WPS_API_PORT=9501
WPS_MOCK_PORT=9502
WPS_REDIS_STREAM_PORT=6379
WPS_REDIS_DATA_PORT=6380

# CRM for the WPS backend (see .tehnical/suiteCRM7/README.md, .tehnical/suiteCRM8/README.md).
# Mock (default): CRM_API_BASE_URL=http://mock:9502, CRM_API_STATIC_KEY=mySecretKey, MOCK_SERVICE_URL=http://mock:9502
# MOCK_SERVICE_URL empty → the modules dictionary is loaded from the CRM (GET {CRM_API_BASE_URL}/modules)
CRM_API_BASE_URL=http://suitecrm8/api/v9
CRM_API_STATIC_KEY=wps8bNvmLOyz9irlajWRiSBJ
MOCK_SERVICE_URL=
