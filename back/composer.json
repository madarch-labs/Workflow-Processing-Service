{
    "name": "wps/backend",
    "description": "Workflow Processing Service — backend on SwooleApp",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-swoole": ">=5.1",
        "sidalex/swoole-app": "^0.3.0"
    },
    "autoload": {
        "psr-4": {
            "Wps\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "yurunsoft/composer-include-files": true,
            "yurunsoft/guzzle-swoole": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
