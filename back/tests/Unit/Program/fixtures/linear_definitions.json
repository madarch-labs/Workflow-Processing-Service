 "suiteCRM7.processes.json:suiteCRM7": {
  "conditions": [
   {
    "field": "object.status",
    "operator": "equals",
    "value_type": "static",
    "value": "New"
   },
   {
    "field": "object.lead_source",
    "operator": "not_equals",
    "value_type": "static",
    "value": ""
   },
   {
    "field": "owner.status",
    "operator": "equals",
    "value_type": "static",
    "value": "Active"
   }
  ],
  "preload": [
   {
    "var": "owner",
    "source": "object_field",
    "module": "Users",
    "by_field": "id",
    "value": "object.assigned_user_id"
   },
   {
    "var": "account",
    "source": "object_field",
    "module": "Accounts",
    "by_field": "name",
    "value": "object.account_name"
   }
  ],
  "actions": [
   {
    "type": "modify",
    "target": "topic.text",
    "change_type": "calculate",
    "value": "concat(trim(concat(object.first_name, ' ', object.last_name)), ' [', upper(object.lead_source), ']')",
    "save_to_crm": false
   },
   {
    "type": "modify",
    "target": "topic.owner_name",
    "change_type": "calculate",
    "value": "trim(concat(owner.first_name, ' ', owner.last_name))",
    "save_to_crm": false
   },
   {
    "type": "modify",
    "target": "object.wps_processed_c",
    "change_type": "set_value",
    "value": "1",
    "save_to_crm": false
   },
   {
    "type": "modify",
    "target": "object.status",
    "change_type": "set_value",
    "value": "In Process",
    "save_to_crm": true
   },
   {
    "type": "start_process",
    "process_names": [
     "suiteCRM7 — звонок",
     "suiteCRM7 — задача"
    ]
   }
  ]
 },
