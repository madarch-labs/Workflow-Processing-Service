# ---------------------------------------------------------------
# WPS backend configuration.
# Order: this file is read first, then real environment variables
# (docker-compose, shell) override or extend its values.
# ---------------------------------------------------------------

# Server (mapped into the SwooleApp config by server.php)
SERVER_HOST=0.0.0.0
SERVER_PORT=9501
SERVER_MODE=PROCESS
SWOOLE_WORKER_NUM=2
SWOOLE_TASK_WORKER_NUM=1
SWOOLE_MAX_COROUTINE=3000
APP_DEBUG=false
LOG_LEVEL=info

# Redis — event bus (stream)
REDIS_STREAM_HOST=127.0.0.1
REDIS_STREAM_PORT=6379
REDIS_STREAM_PASSWORD=
REDIS_STREAM_NAME=crm_events
REDIS_STREAM_CONSUMER_GROUP=wps_workers
REDIS_STREAM_BATCH=10
REDIS_STREAM_BLOCK_MS=2000
# Pending messages idle longer than this are re-claimed (XAUTOCLAIM)
REDIS_STREAM_CLAIM_IDLE_MS=300000

# Redis — data (cache + execution state), a separate instance
REDIS_DATA_HOST=127.0.0.1
REDIS_DATA_PORT=6380
REDIS_DATA_PASSWORD=
REDIS_DATA_DB=0

# PostgreSQL
DB_POSTGRES_HOST=127.0.0.1
DB_POSTGRES_PORT=5432
DB_POSTGRES_DB=wps
DB_POSTGRES_USER=wps
DB_POSTGRES_PASSWORD=secret
DB_POOL_SIZE=16

# External CRM API (SuiteCRM v8-like). "/api/v8" is appended unless already present.
CRM_API_BASE_URL=http://127.0.0.1:9502
CRM_API_STATIC_KEY=mySecretKey
CRM_API_TIMEOUT=10
# Optional: modules dictionary from the mock service instead of the CRM
MOCK_SERVICE_URL=http://127.0.0.1:9502

# Execution
PROCESS_CACHE_TTL=60
DICT_CACHE_TTL=300
ACTION_RETRY_MAX=3
ACTION_RETRY_BASE_DELAY_MS=1000
ACTION_RETRY_BACKOFF=2
EXECUTION_TTL_HOURS=24
EXECUTION_FINISHED_TTL_SECONDS=3600
IDEMPOTENCY_TTL_HOURS=24
EXECUTION_LOCK_TTL=30
MAX_CHILD_DEPTH=10
# Running executions without a live lock older than this are resumed by RecoveryJob
RECOVERY_STALE_SECONDS=300

# Auth
JWT_SECRET=change-me-please-very-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
CORS_ALLOW_ORIGIN=*
