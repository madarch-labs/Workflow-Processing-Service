# ---------------------------------------------------------------
# WPS backend configuration.
# Order: this file is read first, then real environment variables
# (docker-compose, shell) override or extend its values.
# ---------------------------------------------------------------

# Server (mapped into the SwooleApp config by server.php)
SERVER_HOST=0.0.0.0
SERVER_PORT=9501
SERVER_MODE=PROCESS
SWOOLE_WORKER_NUM=2
SWOOLE_TASK_WORKER_NUM=1
SWOOLE_MAX_COROUTINE=3000
APP_DEBUG=false
LOG_LEVEL=info
# Business time zone (IANA name): "today", start of day, date casts in conditions. CRM dates are UTC.
WPS_TIMEZONE=UTC

# Redis — event bus (stream)
REDIS_STREAM_HOST=127.0.0.1
REDIS_STREAM_PORT=6379
REDIS_STREAM_PASSWORD=
REDIS_STREAM_NAME=crm_events
REDIS_STREAM_CONSUMER_GROUP=wps_workers
REDIS_STREAM_BATCH=10
REDIS_STREAM_BLOCK_MS=2000
# Pending messages idle longer than this are re-claimed (XAUTOCLAIM)
REDIS_STREAM_CLAIM_IDLE_MS=300000

# Redis — data (cache + execution state), a separate instance
REDIS_DATA_HOST=127.0.0.1
REDIS_DATA_PORT=6380
REDIS_DATA_PASSWORD=
REDIS_DATA_DB=0

# PostgreSQL
DB_POSTGRES_HOST=127.0.0.1
DB_POSTGRES_PORT=5432
DB_POSTGRES_DB=wps
DB_POSTGRES_USER=wps
DB_POSTGRES_PASSWORD=secret
DB_POOL_SIZE=16

# External CRM API (SuiteCRM v8-like). "/api/v8" is appended unless already present.
CRM_API_BASE_URL=http://127.0.0.1:9502
CRM_API_STATIC_KEY=mySecretKey
CRM_API_TIMEOUT=10
# Optional: modules dictionary from the mock service instead of the CRM
MOCK_SERVICE_URL=http://127.0.0.1:9502

# Execution
PROCESS_CACHE_TTL=60
DICT_CACHE_TTL=300
ACTION_RETRY_MAX=3
ACTION_RETRY_BASE_DELAY_MS=1000
ACTION_RETRY_BACKOFF=2
# upper bound of one retry delay (2s, 10m, 1h …) and the jitter of delays: none | full | equal (7.1)
ACTION_RETRY_MAX_DELAY=1h
ACTION_RETRY_JITTER=full
EXECUTION_TTL_HOURS=24
EXECUTION_FINISHED_TTL_SECONDS=3600
IDEMPOTENCY_TTL_HOURS=24
EXECUTION_LOCK_TTL=30
MAX_CHILD_DEPTH=10
# Running executions without a live lock older than this are resumed by RecoveryJob
RECOVERY_STALE_SECONDS=300
# Flat program: max nesting of blocks (condition / foreach) and instructions per execution (endless goto guard)
PROGRAM_MAX_DEPTH=5
EXECUTION_MAX_INSTRUCTIONS=5000

# Secrets of external actions (secret://name in process definitions). Key: base64 of 32 bytes,
# generate with `php bin/secrets-key.php`. Empty = secrets are not available (the service still starts).
# Rotation: put the old key into WPS_SECRETS_KEY_PREVIOUS, the new one into WPS_SECRETS_KEY, call POST /api/secrets/rotate.
WPS_SECRETS_KEY=
WPS_SECRETS_KEY_PREVIOUS=
# Decrypted values are cached in the worker memory for this many seconds
SECRETS_CACHE_TTL=60

# Journal of external side effects (e-mails, webhooks): rows older than this are purged; Message-ID domain of e-mails
SIDE_EFFECTS_RETENTION_DAYS=30
WPS_MAIL_MESSAGE_ID_DOMAIN=wps.local

# Auth
JWT_SECRET=change-me-please-very-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
CORS_ALLOW_ORIGIN=*

# send_email (md/tasks_list/done/4.1-send-email.md)
# default transport: smtp://user:pass@host:587, smtp://mailpit:1025 for tests; a process may use a secret instead
MAILER_DSN=
MAILER_FROM=wps@wps.local
MAILER_FROM_NAME=WPS
# allowed senders: addresses or domains (@company.ru), comma-separated; empty = any
MAILER_ALLOWED_FROM=
MAILER_TIMEOUT=15
MAILER_MAX_RECIPIENTS=50
MAILER_RATE_PER_MINUTE=60
MAILER_RATE_PER_RECIPIENT_HOUR=10

# http_request (md/tasks_list/done/4.2-http-request.md): SSRF protection and limits
HTTP_ALLOW_PLAIN_HTTP=true
HTTP_DENY_PORTS=22,25,3306,5432,6379,6380,9200,11211
# only these ports / hosts (empty = any); "*.company.ru" matches subdomains
HTTP_ALLOW_PORTS=
HTTP_ALLOW_HOSTS=
# always denied; default: localhost, metadata.google.internal, postgres, redis-stream, redis-data, mock and the CRM host
#HTTP_DENY_HOSTS=
# private networks that may be called (internal ERP etc.), e.g. 10.20.0.0/16
HTTP_ALLOW_PRIVATE_CIDRS=
HTTP_TLS_VERIFY=true
HTTP_CA_FILE=
HTTP_MAX_TIMEOUT=30
HTTP_MAX_RESPONSE_BYTES=5242880
HTTP_MAX_REQUEST_BYTES=1048576
HTTP_RETRY_AFTER_MAX=60
HTTP_MAX_STORED_BODY_BYTES=65536

# link_records / unlink_records: related ids per step (4.12)
LINK_RECORDS_MAX=500

# waiting executions and delay (md/tasks_list/done/7.2-waiting-executions.md, 4.7-delay.md)
WAIT_POLL_INTERVAL_MS=1000
WAIT_BATCH=20
WAIT_LEASE_SECONDS=120
WAIT_MAX_ATTEMPTS=10
# shorter pauses and retry delays stay in the coroutine, longer ones park the execution
WAIT_INLINE_MAX_SECONDS=5
WAIT_STATE_MAX_BYTES=1048576
# the longest delay step
DELAY_MAX=P400D

# find_records (4.10): records per step, related records scanned, size of the list variable
FIND_RECORDS_MAX=500
FIND_RECORDS_SCAN_MAX=1000
FIND_RECORDS_MAX_BYTES=1048576
# foreach: most items of one loop (1..5000); the list snapshot is kept in Redis, not in the execution hash
LOOP_MAX_ITEMS=500
# update_records: most records changed by one step (1..5000)
UPDATE_RECORDS_MAX=200
# aggregate change type: most CRM records read by one aggregation (WPS reads them page by page)
AGGREGATE_MAX_RECORDS=5000
# notify: fields of CRM alerts (suitecrm8 | suitecrm7 | custom) and links to records
CRM_ALERT_PROFILE=suitecrm8
# {module} {module_lower} {module_kebab} {id}; empty — by the profile (8: #/{module_kebab}/record/{id})
CRM_RECORD_URL_TEMPLATE=
# base URL of the CRM UI for absolute links in messengers; empty — CRM_API_BASE_URL without /api/...
CRM_UI_BASE_URL=
TELEGRAM_API_BASE=https://api.telegram.org
# assign: security group members cache, seconds (0 — no cache); most users for least_busy
ASSIGN_POOL_CACHE_TTL=60
ASSIGN_LEAST_BUSY_MAX_POOL=50
