        "enable_coroutine": true,
        "max_coroutine": 3000,
        "package_max_length": 4194304,
        "http_parse_post": false
    },
    "controllers": [
        "Wps\\Controllers"
    ],
    "globalMiddlewares": [
        "Wps\\Middleware\\AuthMiddleware"
    ],
    "CyclicJobs": [
        "Wps\\CyclicJobs\\StreamConsumerJob",
        "Wps\\CyclicJobs\\RecoveryJob"
    ],
    "cyclic_jobs": {
        "strategy": "ALL_WORKERS",
        "monitoring_interval": 60
    },
    "StateContainerInitiation": [
        "Wps\\State\\StateInitiation"
    ],
    "events": []
}
